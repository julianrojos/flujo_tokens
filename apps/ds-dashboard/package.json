{
  "name": "ds-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev-supervisor.mjs",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:split": "node --env-file-if-exists=.env scripts/split-preview.mjs",
    "test": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx --test tests/*.test.ts scripts/*.test.mjs",
    "test:server:routes": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx --test server/routes/*.test.ts",
    "test:server:services": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx --test server/services/*.test.ts",
    "test:frontend": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx --test src/features/**/__tests__/*.test.ts src/features/**/__tests__/*.test.tsx src/components/ui/__tests__/*.test.ts",
    "test:ops:hooks": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx --test src/features/ops/hooks/use-run-all.test.ts",
    "typecheck:tests": "tsc --project tsconfig.test.json",
    "test:db:smoke": "TSX_TSCONFIG_PATH=tsconfig.app.json node --import tsx --test server/db/pg-db-service.test.ts",
    "typecheck:db": "tsc --project tsconfig.db.json --noEmit",
    "build": "tsc -b && vite build",
    "check:bundle-isolation": "node scripts/validate-bundle-isolation.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@flujo/shared": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "@tanstack/react-query": "^5.90.21",
    "@tiptap/extension-blockquote": "^3.20.1",
    "@tiptap/extension-bold": "^3.20.1",
    "@tiptap/extension-bullet-list": "^3.20.1",
    "@tiptap/extension-code": "^3.20.1",
    "@tiptap/extension-document": "^3.20.1",
    "@tiptap/extension-heading": "^3.20.1",
    "@tiptap/extension-italic": "^3.20.1",
    "@tiptap/extension-link": "^3.20.1",
    "@tiptap/extension-list-item": "^3.20.1",
    "@tiptap/extension-ordered-list": "^3.20.1",
    "@tiptap/extension-paragraph": "^3.20.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-strike": "^3.20.1",
    "@tiptap/extension-text": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "ds-types": "*",
    "hono": "^4.12.2",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.469.0",
    "openai": "^6.29.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.5",
    "tiptap-markdown": "0.9.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
