# ============================================================================
# Figma Input
# ============================================================================
# Personal access tokens for Figma API
# Get yours at: https://www.figma.com/settings#tokens (scope: File content -> Read)
FIGMA_TOKEN_CUQUI_02=

# ============================================================================
# AI Providers
# ============================================================================

# Anthropic Claude API
# Get your API key at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=
# Optional model override
# AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI (GPT-4o) API
# Get your API key at: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=
# Optional model override
# AI_OPENAI_MODEL=gpt-4o-mini-2024-07-18

# OpenRouter API
# Get your API key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Optional model/base URL overrides
# AI_OPENROUTER_MODEL=google/gemma-4-26b-a4b-it
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_OPENROUTER_TIMEOUT_MS=120000

# Gemini (Google) API
# Get your API key at: https://aistudio.google.com/app/apikey
# You can set either GEMINI_API_KEY or GOOGLE_API_KEY
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Optional model override
# AI_GEMINI_MODEL=gemini-2.0-flash

# Ollama (Local AI)
# Base URL for Ollama API (default: http://127.0.0.1:11434)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model to use (must be pulled: ollama pull <model>)
# AI_OLLAMA_MODEL=qwen2.5:7b-instruct
# Timeout for Ollama generation (default: 120000ms = 2min)
# AI_OLLAMA_TIMEOUT_MS=120000

# Global job timeout for cloud providers (default: 90000ms)
# AI_JOB_TIMEOUT_MS=90000

# ============================================================================
# Security
# ============================================================================
# Token for securing AI job endpoints (optional, defaults to loopback only)
# DS_DASHBOARD_INTERNAL_TOKEN=your-secure-token-here

# AI Pipeline v2
# Optional: set to false to enforce blocking publication gate.
# Default behavior (unset) is warn-only shadow mode.
# AI_VALIDATION_SHADOW=false
AI_VALIDATION_TIMEOUT_MS=30000

# ============================================================================
# Database
# ============================================================================
# The dashboard dev supervisor falls back to this local URL when DATABASE_URL
# is not set. In production, DATABASE_URL should be provided explicitly.
DATABASE_URL=postgres://ds:local@localhost:5432/ds_dashboard

# ============================================================================
# Embeddings / RAG
# ============================================================================
EMBEDDING_PROVIDER=openai
# IMPORTANT: Must match document_chunks.embedding vector(N) in DB schema.
# If you change this value after migrations are applied, you must regenerate:
# TRUNCATE document_chunks;
EMBEDDING_DIMENSIONS=1536
