# ============================================================================
# Figma Configuration
# ============================================================================
# Personal access tokens for Figma API
# Get yours at: https://www.figma.com/settings#tokens (scope: File content -> Read)
FIGMA_TOKEN_CUQUI_02=

# ============================================================================
# AI Provider Configuration (for component doc generation)
# ============================================================================

# Anthropic Claude API
# Get your API key at: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=

# OpenAI (GPT-4o) API
# Get your API key at: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=

# Optional: Override default AI models
# Anthropic: claude-sonnet-4-20250514 (default), claude-3-opus-20240229, etc.
# AI_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI: gpt-4o-mini-2024-07-18 (default), gpt-4o-2024-08-06, etc.
# AI_OPENAI_MODEL=gpt-4o-mini-2024-07-18

# ============================================================================
# Internal Security (optional)
# ============================================================================
# Token for securing AI job endpoints (optional, defaults to loopback only)
# DS_DASHBOARD_INTERNAL_TOKEN=your-secure-token-here
