# Backend origin for the plugin UI.
VITE_API_URL=http://localhost:8787

# Optional direct WebSocket bridge URL.
# If omitted, the plugin derives ws:// or wss:// from VITE_API_URL when possible.
VITE_DIRECT_WS_URL=ws://localhost:8787/ws/figma-plugin

# Optional extra manifest allowlist entries for production builds.
# Comma-separated match patterns accepted by Figma networkAccess.allowedDomains.
# Example: https://dashboard.example,wss://dashboard.example/ws/figma-plugin
FIGMA_PLUGIN_ALLOWED_DOMAINS=
