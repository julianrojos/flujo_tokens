{
  "name": "figma-mcp-management-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Figma plugin for managing MCP connection to dashboard server",
  "main": "dist/code.js",
  "scripts": {
    "build": "vite build --config vite.config.code.ts && vite build --config vite.config.ui.ts && node scripts/inline-ui-html.mjs",
    "dev": "vite",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.94.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/ui": "^4.0.18",
    "happy-dom": "^20.8.3",
    "jsdom": "^28.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
