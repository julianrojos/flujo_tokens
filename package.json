{
  "name": "css-variables-generator",
  "version": "1.0.0",
  "description": "CSS custom properties generator from JSON tokens",
  "type": "module",
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "generate": "tsx tooling/src/cli/index.ts",
    "generate:registry": "tsx tooling/src/cli/index.ts --registry",
    "generate:strict": "tsx tooling/src/cli/index.ts --mode-strict",
    "validate:docs": "node tooling/scripts/validate-docs.mjs",
    "validate:token-refs": "node tooling/scripts/ds-validate-token-refs.mjs",
    "ds:tokens-sync": "node tooling/scripts/ds-tokens-sync.mjs",
    "ds:tokens-from-figma": "node tooling/scripts/ds-tokens-from-figma.mjs",
    "ds:token-diff": "node tooling/scripts/ds-token-diff.mjs",
    "ds:token-graph": "node tooling/scripts/ds-token-graph.mjs",
    "ds:token-usage-index": "node tooling/scripts/ds-token-usage-index.mjs",
    "ds:token-health": "npm run generate:registry && npm run ds:token-usage-index && npm run ds:token-graph && node tooling/scripts/ds-token-health.mjs",
    "ds:health-snapshot": "node tooling/scripts/ds-health-snapshot.mjs",
    "ds:health:record": "npm run ds:token-health && npm run ds:registry:report && npm run ds:health-snapshot",
    "ds:figma-component-map": "node tooling/scripts/ds-figma-component-map.mjs",
    "ds:component-doc": "node tooling/scripts/ds-component-doc.mjs",
    "ds:sort-spec": "node tooling/scripts/ds-sort-spec.mjs",
    "ds:compute-traceability": "node tooling/scripts/ds-compute-traceability.mjs",
    "ds:capture-visual-proof": "node tooling/scripts/ds-capture-visual-proof.mjs",
    "ds:capture-from-url": "node tooling/scripts/ds-capture-from-figma-url.mjs",
    "ds:capture-from-figma-document": "node tooling/scripts/ds-capture-from-figma-url.mjs",
    "ds:mark-needs-review": "node tooling/scripts/ds-mark-needs-review.mjs",
    "ds:regenerate-docs": "node tooling/scripts/ds-regenerate-docs.mjs",
    "ds:doc-from-figma-url": "node tooling/scripts/ds-doc-from-figma-url.mjs",
    "ds:active-md-to-figma": "node tooling/scripts/ds-active-md-to-figma.mjs",
    "ds:spec-from-figma": "node tooling/scripts/ds-spec-from-figma.mjs",
    "ds:spec-to-markdown": "node tooling/scripts/ds-spec-to-markdown.mjs",
    "ds:component-doc:all": "node tooling/scripts/ds-pipeline.mjs --all --only-step markdown",
    "ds:render-figma:all": "node tooling/scripts/ds-pipeline.mjs --all --only-step render",
    "ds:foundations:sync": "node tooling/scripts/ds-foundations-sync.mjs",
    "ds:registry:sync": "node tooling/scripts/ds-registry-sync.mjs",
    "ds:registry:refresh": "node tooling/scripts/ds-registry-refresh.mjs",
    "ds:registry:validate": "node tooling/scripts/ds-registry-validate.mjs",
    "ds:registry:overview": "node tooling/scripts/ds-registry-overview.mjs",
    "ds:registry:report": "node tooling/scripts/ds-registry-report.mjs",
    "ds:audit-consistency": "node tooling/scripts/ds-audit-consistency.mjs",
    "ds:doctor": "node tooling/scripts/ds-doctor.mjs",
    "ds:pipeline": "node tooling/scripts/ds-pipeline.mjs",
    "test:tooling": "tsx --test tooling/src/utils/exec.test.ts tooling/src/utils/parse-args.test.ts",
    "test:server:node": "node --test apps/ds-dashboard/server/lib/*.test.mjs apps/ds-dashboard/server/routes/*.test.mjs",
    "test:server:tsx": "tsx --test apps/ds-dashboard/server/create-server-app.test.ts apps/ds-dashboard/server/create-server-http-app.test.ts apps/ds-dashboard/server/routes/analysis-routes.test.ts apps/ds-dashboard/server/routes/component-spec-routes.test.ts",
    "test:server": "npm run test:server:node && npm run test:server:tsx",
    "dashboard:dev": "npm --prefix apps/ds-dashboard run dev",
    "dashboard:build": "npm --prefix apps/ds-dashboard run build",
    "dashboard:preview": "npm --prefix apps/ds-dashboard run preview"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
