  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "ds-types": ["../packages/ds-types/src/index.ts"]
    }
  },
  "include": ["scripts/**/*.mjs", "scripts/**/*.js", "src/**/*.ts"]
}
