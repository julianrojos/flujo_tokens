          },
          {
            "text": "**Size**: `376 x 18`"
          },
          {
            "text": "**Layout**: Auto Layout, `HORIZONTAL`"
          },
          {
            "text": "**Item spacing**: `229`"
          },
          {
            "text": "**Children**:"
          },
          {
            "text": "Left: time label (`9:41`)"
          },
          {
            "text": "Right: icons frame (`65.98 x 11`, Auto Layout `HORIZONTAL`, spacing `5`)"
          }
        ]
      },
      {
        "type": "heading",
