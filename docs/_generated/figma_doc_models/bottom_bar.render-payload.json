        "level": 2,
        "text": "Usage Guidelines"
      },
      {
        "type": "list",
        "ordered": false,
        "items": [
          {
            "text": "Use this component as the primary bottom navigation bar for mobile layouts."
          },
          {
            "text": "Keep a stable count and order of actions (five slots in this variant)."
          },
          {
            "text": "Set exactly one button to `Selected` for the current destination when needed."
          },
          {
            "text": "Keep labels short to avoid wrapping or clipping inside button slots."
          }
        ]
      },
      {
        "type": "heading",
        "level": 2,
        "text": "Accessibility"
      },
      {
        "type": "list",
        "ordered": false,
        "items": [
          {
            "text": "Ensure each button label is meaningful and unique when implemented in code."
          },
          {
            "text": "Expose proper button semantics for each action in the host UI."
          },
          {
            "text": "Provide a clear selected-state cue in code when using `State=Selected`."
          },
          {
            "text": "Verify touch targets remain at least `44 x 44` in implementation."
          }
        ]
      },
      {
        "type": "heading",
        "level": 2,
        "text": "Gaps / TBD"
      },
      {
        "type": "list",
        "ordered": false,
        "items": [
          {
            "text": "Root-level selected index/state is not exposed as a single property in this component."
          },
          {
            "text": "No badge/counter slot is defined for notifications."
          },
          {
            "text": "No documented dark-mode variant for the root container."
          },
          {
            "text": "No explicit overflow behavior is defined for long labels."
          }
        ]
