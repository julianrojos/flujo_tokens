          "text": "**Container** (`Auto Layout`, horizontal)"
        },
        {
          "index": 2,
          "text": "**Leading icon** (`24 x 24`, internal vector `18 x 18`)"
        },
        {
          "index": 3,
          "text": "**Text container** with a single message text node"
        }
      ]
    },
    {
