      "level": 2,
      "text": "Usage Guidelines"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        {
          "text": "Use square source images whenever possible to avoid unexpected crops."
        },
        {
          "text": "Keep avatar sizes consistent within the same UI context."
        },
        {
          "text": "For missing images, define a product fallback strategy (initials or placeholder icon) in code."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Accessibility"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        {
          "text": "If decorative only, set `aria-hidden=\"true\"`."
        },
        {
          "text": "If informative, provide descriptive `alt` text."
        },
        {
          "text": "If clickable, use an interactive wrapper (`button`/`a`) with an accessible name."
        },
        {
          "text": "This Figma component does not define a dedicated focus/interaction state."
        }
      ]
    },
