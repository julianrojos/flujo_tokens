    {
      "type": "list",
      "ordered": false,
      "items": [
        {
          "text": "When to use: Use this component to represent a user or entity with a square profile image.",
          "segments": [
            {
              "text": "When to use",
              "style": "bold"
            },
            {
              "text": ": Use this component to represent a user or entity with a square profile image.",
              "style": "normal"
            }
          ]
        },
        {
          "text": "When not to use: Do not use it for icon buttons or status indicators.",
          "segments": [
            {
              "text": "When not to use",
              "style": "bold"
            },
            {
              "text": ": Do not use it for icon buttons or status indicators.",
              "style": "normal"
            }
          ]
        },
        {
          "text": "Do: Use square image assets to avoid unpredictable cropping.",
          "segments": [
            {
              "text": "Do",
              "style": "bold"
            },
            {
              "text": ": Use square image assets to avoid unpredictable cropping.",
              "style": "normal"
            }
          ]
        },
        {
          "text": "Do: Keep avatar size consistent inside the same UI context.",
          "segments": [
            {
              "text": "Do",
              "style": "bold"
            },
            {
              "text": ": Keep avatar size consistent inside the same UI context.",
              "style": "normal"
            }
          ]
        },
        {
          "text": "Don't: Stretch non-square images.",
          "segments": [
            {
              "text": "Don't",
              "style": "bold"
            },
            {
              "text": ": Stretch non-square images.",
              "style": "normal"
            }
          ]
        },
        {
          "text": "Don't: Rely on this component for interaction states not defined in Figma.",
          "segments": [
            {
              "text": "Don't",
              "style": "bold"
            },
            {
              "text": ": Rely on this component for interaction states not defined in Figma.",
              "style": "normal"
            }
          ]
