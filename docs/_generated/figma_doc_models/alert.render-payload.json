        "text": "Variants"
      },
      {
        "type": "table",
        "header": [
          "Variant",
          "Differentiating token(s)",
          "Fallback value(s)",
          "Visual indicator"
        ],
        "rows": [
          [
            "`Information`",
            "`Color/Border/Feedback/Information`, `Color/Icon/Feedback/Information`",
            "`#BAA06B`, `#9D8555`",
            "`information-circle-contained` icon + information border"
          ],
          [
            "`Warning`",
            "`Color/Border/Feedback/Danger`, `Color/Icon/Feedback/Danger`",
            "`#B22222`, `#B22222`",
            "`x-circle-contained` icon + warning border"
