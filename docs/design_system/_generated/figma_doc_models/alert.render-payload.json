        "text": "Usage Guidelines"
      },
      {
        "type": "list",
        "ordered": false,
        "items": [
          {
            "text": "Use `Information` for neutral status or contextual updates."
          },
          {
            "text": "Use `Warning` for error or risky states that require user attention."
          },
          {
            "text": "Use `Positive` for successful outcomes and confirmations."
          },
          {
            "text": "Keep message copy short and direct, ideally one sentence."
          }
        ]
      },
